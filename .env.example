TEAMSWARM_DATABASE_URL=postgresql+asyncpg://teamswarm:teamswarm@localhost:5432/teamswarm
TEAMSWARM_PROVIDER_MODE=mock
OPENAI_API_KEY=
TEAMSWARM_FAST_MODEL=gpt-5.6-terra
TEAMSWARM_STRONG_MODEL=gpt-5.6-sol
TEAMSWARM_FALLBACK_MODEL=gpt-5.6-sol
TEAMSWARM_OLLAMA_BASE_URL=http://localhost:11434
# Disable visible chain-of-thought to preserve the run output-token budget.
TEAMSWARM_OLLAMA_THINK=false
# Refuse a local generation when the host does not have this much reclaimable RAM.
# Optional per-model overrides use comma-separated model=GiB entries.
TEAMSWARM_OLLAMA_MIN_FREE_MEMORY_GB=0
TEAMSWARM_OLLAMA_MODEL_MEMORY_RESERVES_GB=
TEAMSWARM_OLLAMA_FAST_MODEL=llama3.2:3b
TEAMSWARM_OLLAMA_STRONG_MODEL=qwen3:8b
TEAMSWARM_OLLAMA_FALLBACK_MODEL=qwen3:8b
TEAMSWARM_SGLANG_BASE_URL=http://localhost:30000
TEAMSWARM_SGLANG_FAST_MODEL=Qwen/Qwen3-4B
TEAMSWARM_SGLANG_STRONG_MODEL=Qwen/Qwen3-8B
TEAMSWARM_SGLANG_FALLBACK_MODEL=Qwen/Qwen3-8B
# Optional role-specific overrides for the delivery-cycle workflow.
TEAMSWARM_CRITERIA_MODEL=
TEAMSWARM_DISCOVERY_MODEL=
TEAMSWARM_CODING_MODEL=
TEAMSWARM_TESTING_MODEL=
TEAMSWARM_EVALUATOR_MODEL=
TEAMSWARM_TASK_TIMEOUT_SECONDS=45
TEAMSWARM_MAX_TASK_ATTEMPTS=2
TEAMSWARM_TASK_LEASE_SECONDS=120
TEAMSWARM_INLINE_WORKER_ENABLED=true
TEAMSWARM_MAX_CONCURRENT_TASKS=4
TEAMSWARM_MAX_CONCURRENT_TASKS_PER_PROFILE=2
TEAMSWARM_MAX_TOOL_CALLS_PER_TASK=8
TEAMSWARM_TOOL_TIMEOUT_SECONDS=120
TEAMSWARM_MAX_TOOL_OUTPUT_CHARS=50000
TEAMSWARM_CONTEXT_TOKEN_BUDGET=6000
TEAMSWARM_CODE_CONTEXT_ENABLED=false
TEAMSWARM_CODE_CONTEXT_MAX_FILES=500
TEAMSWARM_CODE_CONTEXT_MAX_ITEMS=6
# Exact cache reuse is restricted to safe, read-only standard tasks. Semantic
# reuse is opt-in and additionally requires identical selected context.
TEAMSWARM_RESPONSE_CACHE_ENABLED=true
TEAMSWARM_SEMANTIC_RESPONSE_CACHE_ENABLED=false
TEAMSWARM_SEMANTIC_RESPONSE_CACHE_MIN_SIMILARITY=0.92
TEAMSWARM_PROJECT_CONTEXT_ROOTS=.
TEAMSWARM_SKILL_ROOTS=./skills
TEAMSWARM_DEFAULT_TOKEN_BUDGET=12000
TEAMSWARM_DEFAULT_COST_BUDGET_USD=2.00
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
